class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):                    # quiet
        pass

    def _send(self, code, body=b"", ctype="application/json"):
        if isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(body)

    def _body(self):
        n = int(self.headers.get("Content-Length", 0) or 0)
        if not n:
            return {}
        try:
            return json.loads(self.rfile.read(n) or b"{}")
        except ValueError:
            return {}

    def do_GET(self):
        if self.path == "/" or self.path.startswith("/index"):
            self._send(200, PAGE, "text/html; charset=utf-8")
        elif self.path == "/usage":
            self._send(200, json.dumps(usage()))
        elif self.path == "/workers":
            self._send(200, json.dumps(workers()))
        elif self.path == "/stream":
            self._stream()
        elif self.path == "/health":
            self._send(200, json.dumps({"ok": True, "state": _state["state"]}))
        else:
            self._send(404, json.dumps({"error": "not found"}))

    def do_POST(self):
        body = self._body()
        if self.path == "/event":
            body.setdefault("lane", "iris")
            broadcast(body)
            self._send(200, b'{"ok":true}')
        elif self.path == "/chat":
            text = (body.get("text") or "").strip()
            if text:
                forward_to_brain(text)
            self._send(200, b'{"ok":true}')
        elif self.path == "/say":
            text = (body.get("text") or "").strip()
            if text:
                say_aloud(text)
            self._send(200, b'{"ok":true}')
        elif self.path == "/workers/cleanup":
            res = worker_cleanup(force=bool(body.get("force")))
            self._send(200, json.dumps(res))
        elif self.path == "/reset":
            with _lock:
                _history.clear()
            broadcast({"type": "note", "lane": "iris", "text": "— conversation reset —"})
            self._send(200, b'{"ok":true}')
        elif self.path == "/close":
            broadcast({"type": "close"})
            self._send(200, b'{"ok":true}')
        else:
            self._send(404, json.dumps({"error": "not found"}))

    def _stream(self):
        q = queue.Queue(maxsize=100)
        with _lock:
            _subscribers.append(q)
            backlog = list(_history)
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Connection", "keep-alive")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        try:
            for ev in backlog:
                self.wfile.write(f"data: {json.dumps(ev)}\n\n".encode())
            self.wfile.write(f"data: {json.dumps({'type':'state','state':_state['state']})}\n\n".encode())
            self.wfile.flush()
            while True:
                try:
                    ev = q.get(timeout=20)
                    self.wfile.write(f"data: {json.dumps(ev)}\n\n".encode())
                except queue.Empty:
                    self.wfile.write(b": keepalive\n\n")   # comment frame
                self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass
        finally:
            with _lock:
                if q in _subscribers:
                    _subscribers.remove(q)


def main():
    srv = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
    if SWEEP_SECS > 0:
        threading.Thread(target=sweep_loop, daemon=True).start()
        log(f"idle-worker sweep every {SWEEP_SECS}s (bin={WORKER_BIN})")
    log(f"listening on :{PORT}  (brain ssh={BRAIN_SSH}, usage={USAGE_TRACKER})")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
