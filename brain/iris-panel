#!/usr/bin/env python3
"""
iris-panel — the live web panel for iris, running on GAIA (Paul's laptop).

This is the small HTTP service the rest of iris already talks to on port 4270:

  * the brain (on Olympus) POSTs turn/reply/state events to ``/event`` and
    spoken replies to ``/say``;
  * the Telegram bridge POSTs incoming messages to ``/chat`` and subscribes to
    the ``/stream`` SSE feed to relay replies back;
  * the waybar eye opens ``/`` in a chromium app window to show the live UI.

It keeps a short in-memory history, fans every event out to ``/stream`` (SSE),
and serves a single-page UI. New in v0.9: a **usage** panel — ``/usage`` runs
``usage-tracker.py`` and returns today's token + cost numbers as JSON, which the
UI shows in a header strip.

Endpoints:
    GET  /            the panel UI
    GET  /stream      Server-Sent Events: every event, as ``data: {json}``
    GET  /usage       token usage + cost JSON (cached ~30s)
    GET  /workers     live worker registry: one entry per numbered worker
    POST /event       brain -> panel: {type, ...}
    POST /chat        text in: {text} -> forwarded to the brain
    POST /say         {text} -> spoken aloud on Gaia (best-effort TTS)
    POST /workers/cleanup  {force?} -> stop workers idle >10 min (force kills
                           ones that still hold history)
    POST /reset       clear the conversation/history
    POST /close       ask the open panel window to close itself

Env:
    IRIS_PANEL_PORT   default 4270
    IRIS_BRAIN_SSH    ssh host for the Olympus brain (default "olympus-local")
    IRIS_BRAIN_BIN    brain binary on Olympus (default "iris-brain")
    IRIS_SAY_CMD      command that speaks stdin aloud on Gaia (default "iris-say")
    USAGE_TRACKER     path to usage-tracker.py (default: next to this script)
    IRIS_WORKER_BIN   iris-worker binary for the /workers/cleanup sweep
    IRIS_WORKERS_JSON worker registry path (default: ../brain/workers.json by the
                      worker; the panel reads whatever the worker writes)
    IRIS_WORKER_SWEEP idle-cleanup sweep interval in seconds (0 disables)
"""
import json
import os
import queue
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = int(os.environ.get("IRIS_PANEL_PORT", "4270"))
BRAIN_SSH = os.environ.get("IRIS_BRAIN_SSH", "olympus-local")
BRAIN_BIN = os.environ.get("IRIS_BRAIN_BIN", "iris-brain")
SAY_CMD = os.environ.get("IRIS_SAY_CMD", "iris-say")
HERE = os.path.dirname(os.path.abspath(__file__))
USAGE_TRACKER = os.environ.get("USAGE_TRACKER", os.path.join(HERE, "usage-tracker.py"))
WORKER_BIN = os.environ.get("IRIS_WORKER_BIN",
                            os.path.expanduser("~/.local/bin/iris-worker"))
# The registry the worker writes (mirror its default so /workers reads it directly).
_reg = os.path.expanduser("~/work/iris/brain/workers.json")
if not os.path.isdir(os.path.dirname(_reg)):
    _reg = os.path.expanduser("~/.cache/iris-talk/workers.json")
WORKERS_JSON = os.environ.get("IRIS_WORKERS_JSON", _reg)
SWEEP_SECS = int(os.environ.get("IRIS_WORKER_SWEEP", "120"))   # 0 disables

HISTORY_MAX = 200
_history = []                       # recent events (turns/replies/notes)
_state = {"state": "idle"}
_subscribers = []                   # list[queue.Queue] for SSE
_lock = threading.Lock()

# /usage is expensive (scans every transcript) — cache the result briefly.
_usage_cache = {"at": 0.0, "data": None}
_USAGE_TTL = 30.0


def log(*a):
    print("[iris-panel]", *a, file=sys.stderr, flush=True)


def broadcast(event):
    """Record an event in history and push it to every SSE subscriber."""
    with _lock:
        if event.get("type") in ("turn", "reply", "note"):
            _history.append(event)
            del _history[:-HISTORY_MAX]
        if event.get("type") == "state":
            _state["state"] = event.get("state", "idle")
        subs = list(_subscribers)
    for q in subs:
        try:
            q.put_nowait(event)
        except queue.Full:
            pass


def usage():
    now = time.monotonic()
    if _usage_cache["data"] is not None and now - _usage_cache["at"] < _USAGE_TTL:
        return _usage_cache["data"]
    try:
        out = subprocess.run([sys.executable, USAGE_TRACKER, "--json"],
                             capture_output=True, text=True, timeout=60)
        data = json.loads(out.stdout) if out.returncode == 0 else {"error": out.stderr[:200]}
    except Exception as e:                        # noqa: BLE001
        data = {"error": str(e)}
    _usage_cache.update(at=now, data=data)
    return data


def _pid_alive(pid):
    if not pid:
        return False
    try:
        os.killpg(int(pid), 0)
        return True
    except (OSError, ProcessLookupError, ValueError):
        return False


def workers():
    """Read the worker registry and decorate each entry with liveness + idle age,
    sorted by worker number — the shape the /workers UI row consumes."""
    try:
        with open(WORKERS_JSON) as f:
            reg = json.load(f)
    except (OSError, ValueError):
        reg = {}
    now = time.time()
    out = []
    for k in sorted(reg, key=lambda x: int(x) if str(x).isdigit() else 0):
        v = dict(reg[k])
        alive = v.get("status") == "running" and _pid_alive(v.get("pid"))
        v["alive"] = alive
        last = v.get("last_active") or v.get("started") or now
        v["idle_secs"] = 0 if alive else round(now - last)
        out.append(v)
    return out


def worker_cleanup(force=False):
    """Shell out to iris-worker cleanup; returns its JSON (removed/needs_confirm)."""
    try:
        cmd = [WORKER_BIN, "cleanup", "--json"] + (["--force"] if force else [])
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
        return json.loads(out.stdout) if out.stdout.strip() else {"error": out.stderr[:200]}
    except Exception as e:                        # noqa: BLE001
        return {"error": str(e)}


def sweep_loop():
    """Periodically retire workers idle >10 min. Never force: ones that still
    hold history are surfaced as a note so iris can ask Paul before discarding."""
    while True:
        time.sleep(SWEEP_SECS)
        res = worker_cleanup(force=False)
        if res.get("removed"):
            broadcast({"type": "note", "lane": "iris",
                       "text": f"retired idle workers {res['removed']}"})
        for c in res.get("needs_confirm", []):
            broadcast({"type": "note", "lane": "iris",
                       "text": f"worker-{c['num']} idle {c['idle_min']}m "
                               f"(“{c['task']}”) — say “stop worker {c['num']}” to clear it"})


def forward_to_brain(text):
    """Hand a typed message to the brain on Olympus; its reply comes back to us
    over /event (the brain posts the reply itself), so we just fire it off."""
    def run():
        try:
            subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8",
                            BRAIN_SSH, f"{BRAIN_BIN} text"],
                           input=text, text=True, timeout=180,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception as e:                    # noqa: BLE001
            log("brain forward failed:", e)
            broadcast({"type": "note", "lane": "iris",
                       "text": f"⚠ couldn't reach the brain: {e}"})
    threading.Thread(target=run, daemon=True).start()


def say_aloud(text):
    def run():
        try:
            subprocess.run(SAY_CMD.split(), input=text, text=True, timeout=120,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception as e:                    # noqa: BLE001
            log("say failed:", e)
    threading.Thread(target=run, daemon=True).start()


