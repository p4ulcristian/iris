#!/usr/bin/env python3
"""
iris-panel — a tiny local web server that renders, in real time, what iris (and
the Claude brain behind it) is doing. iris-talk POSTs events here as a turn
unfolds; the browser page subscribes over Server-Sent Events and draws a block
per event (what you said, the context gathered, each tool call, the reply).

Dependency-free (stdlib only). Served at http://127.0.0.1:4270/ and shown in a
floating `chromium --app=` window opened from the waybar eye.

Routes:
    GET  /          the panel page (HTML/CSS/JS, all inline)
    GET  /stream    SSE: replays the current turn's events, then streams live
    POST /event     ingest one event  {type, ...}  (from iris-talk)
    POST /reset     clear the panel for a fresh turn
    GET  /health    {"ok": true}
"""
import json
import os
import queue
import signal
import subprocess
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

# iris-panel runs as a Gaia user service (in the graphical session), so it can
# reach PipeWire — unlike an SSH-spawned worker. So workers POST their spoken
# summary here and we play it locally with proper audio access.
IRIS_SAY = os.path.expanduser("~/.local/bin/iris-say")
IRIS_TALK = os.path.expanduser("~/.local/bin/iris-talk")   # for typed turns → brain

# Bind on all interfaces so the brain on Olympus can POST events over WireGuard.
HOST = os.environ.get("IRIS_PANEL_HOST", "0.0.0.0")
PORT = int(os.environ.get("IRIS_PANEL_PORT", "4270"))
STATE_DIR = os.path.expanduser("~/.cache/iris-talk")
HISTORY_FILE = os.path.join(STATE_DIR, "panel-events.json")
MAX_EVENTS = 600

_lock = threading.Lock()
_events = []                 # ordered list of event dicts (current view)
_clients = []                # list of queue.Queue, one per SSE connection
_chat_proc = None            # the in-flight typed turn (so a new one can disrupt it)


def _load():
    global _events
    try:
        with open(HISTORY_FILE) as f:
            _events = json.load(f)[-MAX_EVENTS:]
    except (OSError, ValueError):
        _events = []


def _persist():
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = HISTORY_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(_events[-MAX_EVENTS:], f)
    os.replace(tmp, HISTORY_FILE)


def publish(event):
    """Append an event and fan it out to every connected browser."""
    with _lock:
        _events.append(event)
        del _events[:-MAX_EVENTS]
        _persist()
        clients = list(_clients)
    for q in clients:
        try:
            q.put_nowait(event)
        except queue.Full:
            pass


def reset():
    with _lock:
        _events.clear()
        _persist()
        clients = list(_clients)
    for q in clients:
        try:
            q.put_nowait({"type": "reset"})
        except queue.Full:
            pass


def interrupt_speech():
    """Stop whatever iris is saying/doing right now — the in-flight typed reply,
    any iris-say playback, and (via the edge daemon) a voice reply mid-stream."""
    global _chat_proc
    if _chat_proc and _chat_proc.poll() is None:
        try:
            os.killpg(os.getpgid(_chat_proc.pid), signal.SIGTERM)
        except Exception:                        # noqa: BLE001
            pass
        _chat_proc = None
    subprocess.run([IRIS_SAY, "--stop"], check=False)
    try:
        with open(os.path.expanduser("~/.cache/iris-talk/edge.pid")) as f:
            os.kill(int(f.read().strip()), signal.SIGUSR1)
    except Exception:                            # noqa: BLE001
        pass


PAGE = r"""<!doctype html>
