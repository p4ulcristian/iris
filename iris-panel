<script>
const panes={iris:document.getElementById('pane-iris'),worker:document.getElementById('pane-worker')};
const empties={iris:document.getElementById('empty'),worker:document.getElementById('wempty')};
const dots={iris:document.getElementById('dot'),worker:document.getElementById('wdot')};
const texts={iris:document.getElementById('stateText'),worker:null};
const spins={iris:document.getElementById('spin'),worker:document.getElementById('wspin')};
function esc(s){return (s||'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));}
function fmt(s){
  s=esc(s);
  s=s.replace(/```(\w*)\n?([\s\S]*?)```/g,(m,l,c)=>`<pre class="code">${c.replace(/\n$/,'')}</pre>`);
  return s;
}
function atBottom(p){ return p.scrollHeight-p.scrollTop-p.clientHeight < 80; }
function add(lane,el){
  const p=panes[lane]||panes.iris, e=empties[lane];
  if(e&&e.parentNode) e.remove();
  const stick=atBottom(p); p.appendChild(el); if(stick) p.scrollTop=p.scrollHeight;
  return el;
}
function block(lane,cls,label,icon,bodyHtml){
  const d=document.createElement('div'); d.className='block '+cls;
  d.innerHTML=`<div class="lbl">${icon||''} ${label}</div><div class="body">${bodyHtml}</div>`;
  return add(lane,d);
}
function setState(lane,s){ const dot=dots[lane]; if(dot) dot.className='dot '+s;
  if(texts[lane]) texts[lane].textContent=s;
  const sp=spins[lane]; if(sp) sp.className='spin'+(['thinking','listening','running'].includes(s)?' on':''); }
const live={iris:null,worker:null};   // streaming text accumulator per lane
function handle(ev){
  const lane=ev.lane||'iris', worker=lane==='worker';
  switch(ev.type){
    case 'reset':
      panes.iris.innerHTML='<div class="empty">cleared — hold Fn and say something</div>';
      panes.worker.innerHTML='<div class="empty">idle</div>';
      live.iris=null; live.worker=null; break;
    case 'turn':
      if(panes[lane].querySelector('.block')){const s=document.createElement('div');s.className='turn-sep';add(lane,s);}
      live[lane]=null;
      block(lane, worker?'task':'you', worker?'task':'you', worker?'🛠':'🗣', fmt(ev.text)); break;
    case 'context':
      block(lane,'context','context','👁',fmt(ev.block)); break;
    case 'tool':{
      let inp = ev.input? `<pre>${esc(typeof ev.input==='string'?ev.input:JSON.stringify(ev.input,null,2))}</pre>`:'';
      block(lane,'tool','tool · '+esc(ev.name),'🔧',`<span>${esc(ev.summary||'')}</span>${inp}`); break;}
    case 'assistant_text':
      if(!live[lane]) live[lane]=block(lane, worker?'wreply':'iris', worker?'worker':'iris', worker?'🛠':'💬','');
      live[lane].querySelector('.body').innerHTML += fmt(ev.text);
      if(atBottom(panes[lane])) panes[lane].scrollTop=panes[lane].scrollHeight; break;
    case 'reply':
      if(live[lane]){ live[lane].querySelector('.body').innerHTML=fmt(ev.text); live[lane]=null; }
      else block(lane, worker?'wreply':'iris', worker?'worker':'iris', worker?'🛠':'💬', fmt(ev.text)); break;
    case 'note':{ const d=document.createElement('div'); d.className='note'; d.textContent=ev.text; add(lane,d); break; }
    case 'state': setState(lane, ev.state); break;
    case 'close': window.close(); break;
  }
}
