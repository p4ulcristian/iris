class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):           # quiet
        pass

    def _send(self, code, body=b"", ctype="text/plain"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if body:
            self.wfile.write(body)

    def do_GET(self):
        if self.path == "/" or self.path.startswith("/index"):
            self._send(200, PAGE.encode("utf-8"), "text/html; charset=utf-8")
        elif self.path == "/health":
            self._send(200, b'{"ok":true}', "application/json")
        elif self.path == "/stream":
            self._stream()
        else:
            self._send(404)

    def do_POST(self):
        n = int(self.headers.get("Content-Length", 0))
        raw = self.rfile.read(n) if n else b"{}"
        if self.path == "/reset":
            reset()
            self._send(200, b'{"ok":true}', "application/json")
            return
        if self.path == "/close":
            for q in list(_clients):
                try:
                    q.put_nowait({"type": "close"})
                except queue.Full:
                    pass
            self._send(200, b'{"ok":true}', "application/json")
            return
        if self.path == "/interrupt":            # fired the moment you start typing
            interrupt_speech()
            self._send(200, b'{"ok":true}', "application/json")
            return
        if self.path == "/chat":
            global _chat_proc
            try:
                text = json.loads(raw).get("text", "")
            except ValueError:
                text = ""
            if text:
                interrupt_speech()               # replace whatever iris was doing
                _chat_proc = subprocess.Popen(
                    [IRIS_TALK, "text-turn", text],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    start_new_session=True)
            self._send(200, b'{"ok":true}', "application/json")
            return
        if self.path == "/say":
            try:
                text = json.loads(raw).get("text", "")
            except ValueError:
                text = ""
            if text:
                # play in the background so the POST returns immediately
                def _play(t):
                    p = subprocess.Popen([IRIS_SAY], stdin=subprocess.PIPE, text=True)
                    try:
                        p.communicate(t, timeout=120)
                    except Exception:        # noqa: BLE001
                        pass
                threading.Thread(target=_play, args=(text,), daemon=True).start()
            self._send(200, b'{"ok":true}', "application/json")
            return
        if self.path == "/event":
            try:
                publish(json.loads(raw))
                self._send(200, b'{"ok":true}', "application/json")
            except ValueError:
                self._send(400, b'{"error":"bad json"}', "application/json")
            return
        self._send(404)

    def _stream(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Connection", "keep-alive")
        self.end_headers()
        q = queue.Queue(maxsize=1000)
        with _lock:
            backlog = list(_events)
            _clients.append(q)
        try:
            for ev in backlog:
                self._write_event(ev)
            while True:
                try:
                    ev = q.get(timeout=20)
                    self._write_event(ev)
                except queue.Empty:
                    self.wfile.write(b": ping\n\n")   # keep-alive
                    self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass
        finally:
            with _lock:
                if q in _clients:
                    _clients.remove(q)

    def _write_event(self, ev):
        self.wfile.write(b"data: " + json.dumps(ev).encode("utf-8") + b"\n\n")
        self.wfile.flush()


def main():
    _load()
    srv = ThreadingHTTPServer((HOST, PORT), Handler)
    srv.daemon_threads = True
    print(f"iris-panel: http://{HOST}:{PORT}/  ({len(_events)} events loaded)", flush=True)
    srv.serve_forever()


if __name__ == "__main__":
    main()
