  if(!chatin.value) typedInterrupt=false;
});
chatbar.addEventListener('submit',e=>{ e.preventDefault(); const t=chatin.value.trim(); if(!t) return;
  chatin.value=''; typedInterrupt=false;
  fetch('/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:t})}); });
const es=new EventSource('/stream');
es.onmessage=e=>{ try{ handle(JSON.parse(e.data)); }catch(_){} };
es.onerror=()=>{};
