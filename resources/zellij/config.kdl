// Iris bundled zellij config - minimal UI for embedding
keybinds clear-defaults=true {
    normal clear-defaults=true {}
    locked clear-defaults=true {}
    pane clear-defaults=true {}
    tab clear-defaults=true {}
    resize clear-defaults=true {}
    move clear-defaults=true {}
    scroll clear-defaults=true {}
    search clear-defaults=true {}
    session clear-defaults=true {}
    tmux clear-defaults=true {}
}
show_startup_tips false
pane_frames false
default_layout "compact"
simplified_ui true
// Clipboard: use OSC 52 to system clipboard (handled by xterm addon)
copy_on_select true
copy_clipboard "system"
// Disable session manager UI
disable_session_metadata true
// Use Kitty keyboard protocol to prevent Alt from toggling mouse mode
support_kitty_keyboard_protocol true
