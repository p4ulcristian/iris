#!/bin/bash
#
# Iris - Unified control for Iris brain and orchestration
#
# Usage:
#   iris                    Start all components (cli + servers)
#   iris cli                Start just tmux session
#   iris hear               Start just hear server
#   iris speak              Start just speak server
#   iris express            Start just express server
#   iris wake               Start just wake coordinator
#   iris hear speak wake    Start multiple components
#
#   iris stop               Stop all servers (keep cli running)
#   iris stop all           Stop everything including cli
#   iris stop hear          Stop specific server
#
#   iris logs               Tail all server logs
#   iris logs hear          Tail specific server log
#
#   iris spawn <task>       Spawn a shade (delegate to oversee/iris.sh)
#   iris kill <name>        Kill shade
#   iris send <name> <msg>  Send message to shade
#   iris list               List active shades
#   ...and other shade commands (see oversee/iris.sh)

set -e

IRIS_DIR="$HOME/Iris"
BRAIN_DIR="$IRIS_DIR/brain"
OVERSEE_DIR="$BRAIN_DIR/oversee"
VENV="$BRAIN_DIR/.venv"
PID_DIR="/tmp/iris"
LOG_DIR="/tmp/iris"

# Ensure directories exist
mkdir -p "$PID_DIR" "$LOG_DIR"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# Component definitions
declare -A COMPONENTS=(
    [hear]="$BRAIN_DIR/hear/server.py:8766"
    [speak]="$BRAIN_DIR/speak/server.py:8765"
    [express]="$BRAIN_DIR/express/server.py:8767"
    [wake]="$BRAIN_DIR/wake/listener.py:-"
)

# Start a server component
start_component() {
    local name=$1
    local info=${COMPONENTS[$name]}

    if [ -z "$info" ]; then
        echo -e "${RED}Unknown component: $name${NC}"
        return 1
    fi

    IFS=: read -r script port <<< "$info"
    local pidfile="$PID_DIR/$name.pid"
    local logfile="$LOG_DIR/$name.log"

    # Check if already running
    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
        echo -e "${YELLOW}$name already running${NC}"
        return 0
    fi

    echo -e "${CYAN}Starting $name...${NC}"

    # Activate venv and start component in background
    (
        source "$VENV/bin/activate"
        python "$script" >> "$logfile" 2>&1 &
        echo $! > "$pidfile"
    )

    sleep 0.5

    # Verify it started
    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
        echo -e "${GREEN}$name started (PID: $(cat "$pidfile"))${NC}"
    else
        echo -e "${RED}Failed to start $name${NC}"
        return 1
    fi
}

# Stop a server component
stop_component() {
    local name=$1
    local pidfile="$PID_DIR/$name.pid"

    if [ ! -f "$pidfile" ]; then
        echo -e "${YELLOW}$name not running${NC}"
        return 0
    fi

    local pid=$(cat "$pidfile")

    if kill -0 "$pid" 2>/dev/null; then
        echo -e "${CYAN}Stopping $name...${NC}"
        kill "$pid" 2>/dev/null || true
        rm -f "$pidfile"
        echo -e "${GREEN}$name stopped${NC}"
    else
        echo -e "${YELLOW}$name not running (stale PID file)${NC}"
        rm -f "$pidfile"
    fi
}

# Start CLI (tmux session)
start_cli() {
    "$OVERSEE_DIR/iris.sh" start
}

# Tail logs
tail_logs() {
    shift  # Remove 'logs' from args

    if [ $# -eq 0 ]; then
        # Tail all logs
        tail -f "$LOG_DIR"/*.log
    else
        # Tail specific logs
        local logs=()
        for name in "$@"; do
            logs+=("$LOG_DIR/$name.log")
        done
        tail -f "${logs[@]}"
    fi
}

# Main command dispatcher
cmd=$1
shift || true

case "$cmd" in
    # Start components
    ""|start|up)
        # No args or 'start' - start all
        if [ $# -eq 0 ]; then
            start_cli
            start_component speak
            start_component hear
            start_component express
            start_component wake
        else
            # Start specific components
            for comp in "$@"; do
                if [ "$comp" = "cli" ]; then
                    start_cli
                else
                    start_component "$comp"
                fi
            done
        fi
        ;;

    # Stop components
    stop)
        if [ "$1" = "all" ]; then
            # Stop everything
            stop_component wake
            stop_component express
            stop_component hear
            stop_component speak
            "$OVERSEE_DIR/iris.sh" stop
        elif [ $# -eq 0 ]; then
            # Stop just servers
            stop_component wake
            stop_component express
            stop_component hear
            stop_component speak
        else
            # Stop specific components
            for comp in "$@"; do
                stop_component "$comp"
            done
        fi
        ;;

    # Logs
    logs|log)
        tail_logs "$@"
        ;;

    # Shade management - delegate to oversee/iris.sh
    spawn|kill|send|peek|list|status|run)
        exec "$OVERSEE_DIR/iris.sh" "$cmd" "$@"
        ;;

    # CLI management - delegate to oversee/iris.sh
    cli)
        exec "$OVERSEE_DIR/iris.sh" "$@"
        ;;

    # Individual component names (shorthand for start)
    hear|speak|express|wake)
        start_component "$cmd"
        ;;

    # Help
    help|--help|-h)
        cat << EOF
Iris - Unified control for Iris brain and orchestration

Component Control:
  iris                    Start all (cli + hear + speak + express + wake)
  iris cli                Start just tmux session
  iris hear               Start just hear server
  iris speak              Start just speak server
  iris express            Start just express server
  iris wake               Start just wake coordinator
  iris hear speak wake    Start multiple components

  iris stop               Stop servers only (keep cli running)
  iris stop all           Stop everything including cli
  iris stop hear          Stop specific server

  iris logs               Tail all server logs
  iris logs hear speak    Tail specific logs

Shade Management (delegates to oversee/iris.sh):
  iris spawn <task>       Spawn a shade
  iris kill <name|all>    Kill shade(s)
  iris send <name> <msg>  Send message to shade
  iris peek <name>        View shade output
  iris list               List active shades
  iris run <cmd>          Run command in project context

For more shade commands, see: $OVERSEE_DIR/iris.sh --help
EOF
        ;;

    *)
        echo -e "${RED}Unknown command: $cmd${NC}"
        echo "Run 'iris help' for usage information"
        exit 1
        ;;
esac
