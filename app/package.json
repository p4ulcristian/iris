{
  "name": "iris",
  "version": "2.0.0",
  "description": "Voice assistant that summons the Greek pantheon",
  "main": "main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,server,electron -c cyan,green,magenta \"bun:dev:vite\" \"bun:dev:server\" \"sleep 2 && bun run dev:electron\"",
    "dev:vite": "bunx --bun vite",
    "dev:server": "bun --watch server/index.js",
    "dev:electron": "electron . --dev",
    "build": "bunx --bun vite build && electron-builder",
    "preview": "bunx --bun vite preview"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.7.7",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^6.0.0",
    "framer-motion": "^12.23.26",
    "googleapis": "^169.0.0",
    "immer": "^11.1.0",
    "js-yaml": "^4.1.1",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.0.0",
    "electron": "^39.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
