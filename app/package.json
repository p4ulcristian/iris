{
  "name": "iris",
  "version": "2.0.0",
  "description": "Voice assistant that summons the Greek pantheon",
  "main": "main/index.js",
  "type": "module",
  "scripts": {
    "generate:themes": "node ../scripts/generate-themes.js",
    "dev": "npm run generate:themes && concurrently -k \"vite\" \"node -e 'setTimeout(()=>{},2000)' && electron . --dev\"",
    "dev:vite": "vite",
    "dev:electron": "electron . --dev",
    "build": "npm run generate:themes && vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^6.0.0",
    "immer": "^11.1.0",
    "motion": "^12.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.0.0",
    "electron": "^39.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
