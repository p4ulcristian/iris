[Unit]
Description=iris-talk — Fn hold-to-talk voice companion (watches Hyprland, talks back)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u %h/.local/bin/iris-talk edge-daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
