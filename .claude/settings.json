{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -sX POST http://127.0.0.1:9998/api/ready -H 'Content-Type: application/json' -d '{\"god\":\"'\"$GOD_NAME\"'\",\"state\":\"working\"}' 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -sX POST http://127.0.0.1:9998/api/ready -H 'Content-Type: application/json' -d '{\"god\":\"'\"$GOD_NAME\"'\",\"state\":\"done\"}' 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -sX POST http://127.0.0.1:9998/api/hook -H 'Content-Type: application/json' -d \"$(cat | jq -c '. + {god: env.GOD_NAME}')\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
